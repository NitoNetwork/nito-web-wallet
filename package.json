{
  "name": "nito-wallet-web",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "npm run crypto:build && vinext build && node scripts/verify-build-security.mjs",
    "build:reproducible": "node scripts/verify-reproducible-build.mjs",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint app src lib components scripts worker.ts vite.config.ts next.config.ts --deny-warnings",
    "test": "npm run crypto:build && vitest run",
    "crypto:format": "cargo fmt --manifest-path native/nito-wallet-crypto-web/Cargo.toml --check",
    "crypto:test": "cargo test --manifest-path native/nito-wallet-crypto-web/Cargo.toml --locked",
    "crypto:build": "node scripts/build-wasm.mjs",
    "crypto:check": "npm run crypto:format && npm run crypto:test && npm run crypto:build",
    "check": "npm run version:verify && npm run crypto:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run deployment:smoke && npm run security:supply-chain && npm run deployment:verify",
    "audit:production": "npm audit --omit=dev",
    "deployment:verify": "node scripts/verify-deployment-config.mjs",
    "deployment:smoke": "node scripts/smoke-standalone.mjs",
    "security:supply-chain": "node scripts/verify-supply-chain.mjs",
    "version:set": "node scripts/version.mjs set",
    "version:verify": "node scripts/version.mjs verify",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@noble/hashes": "2.2.0",
    "@scure/bip39": "2.2.0",
    "@scure/btc-signer": "2.2.0",
    "@shadcn/react": "0.3.0",
    "bech32": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "qr": "0.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "tweetnacl": "1.0.3",
    "vinext": "1.0.0-beta.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/workers-types": "5.20260830.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "wrangler": "4.127.1"
  },
  "type": "module"
}
